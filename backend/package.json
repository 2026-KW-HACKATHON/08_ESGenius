    "data:safety": "tsx scripts/apply-safety.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.0",
    "@fastify/helmet": "^13.0.0",
    "@fastify/rate-limit": "^10.0.0",
    "@fastify/swagger": "^9.0.0",
    "@fastify/swagger-ui": "^6.1.1",
    "@sinclair/typebox": "^0.34.0",
    "dotenv": "^17.0.0",
    "fastify": "^5.0.0",
    "jose": "^6.0.0"
  },
