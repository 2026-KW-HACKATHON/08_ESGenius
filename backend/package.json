  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/src/server.js",
    "build": "tsc",
    "check": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "setup": "tsx scripts/setup.ts",
