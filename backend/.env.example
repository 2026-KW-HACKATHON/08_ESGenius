NODE_ENV=development
HOST=127.0.0.1
PORT=4100
DATABASE_PATH=./data/wolgye.sqlite
# false: never seed illustrative data; production must be false.
DEMO_MODE=false
# npm run setup generates random local credentials, never ship these in an app.
DEV_USER_TOKEN=
DEV_ADMIN_TOKEN=
KAKAO_REST_API_KEY=
# JWT from the mobile app's identity provider, e.g. Supabase Auth.
JWT_ISSUER=
JWT_AUDIENCE=authenticated
JWT_JWKS_URL=
# Comma-separated verified JWT subject IDs. Never trust a role sent by a client.
ADMIN_SUBJECTS=
# Native apps do not require CORS. Optional web preview origins only.
CORS_ORIGINS=http://localhost:3000
