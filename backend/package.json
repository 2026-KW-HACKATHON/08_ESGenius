    "openapi": "tsx scripts/openapi.ts",
    "data:load": "tsx scripts/import.ts data/wolgye1.dataset.json",
    "data:constructions": "tsx scripts/collect-constructions.ts",
    "data:construction-projects": "tsx scripts/collect-construction-projects.ts",
    "mobile": "tsx scripts/mobile.ts",
    "data:cctv": "tsx scripts/collect-safety.ts",
