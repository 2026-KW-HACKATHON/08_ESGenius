# Public JavaScript key only. Never put KAKAO_REST_API_KEY or admin tokens here.
VITE_KAKAO_JAVASCRIPT_KEY=
# Empty = same-origin /api. Vite proxies to the local backend during development.
VITE_API_URL=
# Optional email/password authentication. Match backend JWT issuer/JWKS.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
