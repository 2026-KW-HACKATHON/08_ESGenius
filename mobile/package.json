{
  "name": "chongchong-mobile",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173",
    "build": "tsc --noEmit && vite build",
    "check": "tsc --noEmit",
    "sync": "npm run build && cap sync android",
    "android": "cap open android",
    "test": "tsx --test test/*.test.ts",
    "build:device": "tsc --noEmit && vite build --mode development",
    "sync:device": "npm run build:device && cap sync android",
    "preview": "vite preview"
  },
  "dependencies": {
    "@capacitor/android": "8.5.2",
    "@capacitor/app": "^8.0.0",
    "@capacitor/core": "8.5.2",
    "@capacitor/geolocation": "^8.0.0",
    "@capacitor/preferences": "^8.0.0",
    "@supabase/supabase-js": "^2.0.0",
    "suncalc": "^2.1.1"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.2",
    "@types/node": "^24.0.0",
    "sharp": "^0.35.5",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "8.3.2"
  },
  "overrides": {
    "uuid": "11.1.1"
  }
}
